{
  "$schema": "open-symbolic-rules/v0.1",
  "section": "algebra",
  "title": "Basic Algebraic Simplifications",
  "rules": [
    {
      "id": 1,
      "description": "Identity of Addition",
      "pattern": ["Add", "~x", 0],
      "result": "~x"
    },
    {
      "id": 2,
      "description": "Identity of Addition (Commutative)",
      "pattern": ["Add", 0, "~x"],
      "result": "~x"
    },
    {
      "id": 3,
      "description": "Identity of Multiplication",
      "pattern": ["Mul", "~x", 1],
      "result": "~x"
    },
    {
      "id": 4,
      "description": "Identity of Multiplication (Commutative)",
      "pattern": ["Mul", 1, "~x"],
      "result": "~x"
    },
    {
      "id": 5,
      "description": "Annihilation of Multiplication",
      "pattern": ["Mul", "~x", 0],
      "result": 0
    },
    {
      "id": 6,
      "description": "Annihilation of Multiplication (Commutative)",
      "pattern": ["Mul", 0, "~x"],
      "result": 0
    },
    {
      "id": 7,
      "description": "Power of 1",
      "pattern": ["Pow", "~x", 1],
      "result": "~x"
    },
    {
      "id": 8,
      "description": "Power of 0",
      "pattern": ["Pow", "~x", 0],
      "result": 1
    },
    {
      "id": 9,
      "description": "Division by 1",
      "pattern": ["Div", "~x", 1],
      "result": "~x"
    },
    {
      "id": 10,
      "description": "Zero divided by anything",
      "pattern": ["Div", 0, "~x"],
      "result": 0
    },
    {
      "id": 11,
      "description": "Subtraction of a number from itself",
      "pattern": ["Add", "~x", ["Mul", -1, "~x"]],
      "result": 0
    }
  ]
}
