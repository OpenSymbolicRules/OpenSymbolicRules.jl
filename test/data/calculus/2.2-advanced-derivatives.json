{
  "$schema": "open-symbolic-rules/v0.1",
  "section": "2.2",
  "title": "Advanced Derivatives (Linearity, Product, Chain Rules)",
  "semantics": {
    "Derivative": "openmath:calculus1#diff",
    "Add": "openmath:arith1#plus",
    "Mul": "openmath:arith1#times",
    "Div": "openmath:arith1#divide",
    "Pow": "openmath:arith1#power",
    "Exp": "openmath:transc1#exp",
    "Log": "openmath:transc1#ln",
    "Sin": "openmath:transc1#sin",
    "Cos": "openmath:transc1#cos"
  },
  "rules": [
    {
      "id": 1,
      "description": "Derivative of variable w.r.t itself",
      "pattern": ["Derivative", "~x", "~x"],
      "constraints": [],
      "result": 1
    },
    {
      "id": 2,
      "description": "Derivative of a constant",
      "pattern": ["Derivative", "~c", "~x"],
      "constraints": [
        ["FreeQ", "~c", "~x"]
      ],
      "result": 0
    },
    {
      "id": 3,
      "description": "Linearity: d/dx(u + v)",
      "pattern": ["Derivative", ["Add", "~u", "~v"], "~x"],
      "constraints": [],
      "result": ["Add", ["Derivative", "~u", "~x"], ["Derivative", "~v", "~x"]]
    },
    {
      "id": 4,
      "description": "Constant multiple: d/dx(c * u)",
      "pattern": ["Derivative", ["Mul", "~c", "~u"], "~x"],
      "constraints": [
        ["FreeQ", "~c", "~x"]
      ],
      "result": ["Mul", "~c", ["Derivative", "~u", "~x"]]
    },
    {
      "id": 5,
      "description": "Product rule: d/dx(u * v)",
      "pattern": ["Derivative", ["Mul", "~u", "~v"], "~x"],
      "constraints": [],
      "result": ["Add", 
        ["Mul", ["Derivative", "~u", "~x"], "~v"], 
        ["Mul", "~u", ["Derivative", "~v", "~x"]]
      ]
    },
    {
      "id": 6,
      "description": "Quotient rule: d/dx(u / v)",
      "pattern": ["Derivative", ["Div", "~u", "~v"], "~x"],
      "constraints": [],
      "result": ["Div",
        ["Add", 
          ["Mul", ["Derivative", "~u", "~x"], "~v"],
          ["Mul", -1, ["Mul", "~u", ["Derivative", "~v", "~x"]]]
        ],
        ["Pow", "~v", 2]
      ]
    },
    {
      "id": 7,
      "description": "Power rule (Chain): d/dx(u^n)",
      "pattern": ["Derivative", ["Pow", "~u", "~n"], "~x"],
      "constraints": [
        ["FreeQ", "~n", "~x"]
      ],
      "result": ["Mul", 
        ["Mul", "~n", ["Pow", "~u", ["Add", "~n", -1]]],
        ["Derivative", "~u", "~x"]
      ]
    },
    {
      "id": 8,
      "description": "Exponential rule (Chain): d/dx(exp(u))",
      "pattern": ["Derivative", ["Exp", "~u"], "~x"],
      "constraints": [],
      "result": ["Mul", ["Exp", "~u"], ["Derivative", "~u", "~x"]]
    },
    {
      "id": 9,
      "description": "Logarithm rule (Chain): d/dx(log(u))",
      "pattern": ["Derivative", ["Log", "~u"], "~x"],
      "constraints": [],
      "result": ["Mul", ["Div", 1, "~u"], ["Derivative", "~u", "~x"]]
    },
    {
      "id": 10,
      "description": "Sine rule (Chain): d/dx(sin(u))",
      "pattern": ["Derivative", ["Sin", "~u"], "~x"],
      "constraints": [],
      "result": ["Mul", ["Cos", "~u"], ["Derivative", "~u", "~x"]]
    },
    {
      "id": 11,
      "description": "Cosine rule (Chain): d/dx(cos(u))",
      "pattern": ["Derivative", ["Cos", "~u"], "~x"],
      "constraints": [],
      "result": ["Mul", ["Mul", -1, ["Sin", "~u"]], ["Derivative", "~u", "~x"]]
    }
  ]
}
