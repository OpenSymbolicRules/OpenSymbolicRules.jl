{
  "$schema": "open-symbolic-rules/v0.1",
  "section": "1.1",
  "title": "Basic Limits",
  "semantics": {
    "Limit": "openmath:limit1#limit",
    "Sin": "openmath:transc1#sin",
    "Div": "openmath:arith1#divide",
    "Add": "openmath:arith1#plus"
  },
  "rules": [
    {
      "id": 1,
      "description": "Limit of a constant: lim_{x->a} c = c",
      "pattern": [
        "Limit",
        "~c",
        "~x",
        "~a"
      ],
      "constraints": [
        [
          "FreeQ",
          "~c",
          "~x"
        ]
      ],
      "result": "~c",
      "provenance": {
        "method": "authored",
        "sources": [
          {
            "name": "OpenSymbolicRules.jl test fixtures",
            "locator": "test/data/calculus/1.1-basic-limits.json"
          }
        ]
      }
    },
    {
      "id": 2,
      "description": "Fundamental sine limit: lim_{x->0} sin(x)/x = 1",
      "pattern": [
        "Limit",
        [
          "Div",
          [
            "Sin",
            "~x"
          ],
          "~x"
        ],
        "~x",
        0
      ],
      "constraints": [],
      "result": 1,
      "provenance": {
        "method": "authored",
        "sources": [
          {
            "name": "OpenSymbolicRules.jl test fixtures",
            "locator": "test/data/calculus/1.1-basic-limits.json"
          }
        ]
      }
    }
  ],
  "identity": "test:calculus/1.1-basic-limits"
}
