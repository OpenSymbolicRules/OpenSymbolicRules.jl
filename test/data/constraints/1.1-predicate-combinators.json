    {
      "id": 2,
      "description": "Exposes the exponent of a positive or integer power",
      "pattern": [
        "Pow",
        "~x",
        "~m"
      ],
      "constraints": [
        [
          "Or",
          [
            "IntegerQ",
            "~m"
          ],
          [
            "And",
            [
              "PosQ",
              "~m"
            ],
            [
              "Not",
              [
                "EqQ",
                "~m",
                0
              ]
            ]
          ]
        ]
      ],
      "result": "~m",
      "provenance": {
