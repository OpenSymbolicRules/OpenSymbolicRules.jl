{
  "$schema": "open-symbolic-rules/v0.1",
  "section": "1.5",
  "title": "Unproved constraint fixture",
  "semantics": {
    "Power": "openmath:arith1#power",
    "Multiply": "openmath:arith1#times"
  },
  "rules": [
    {
      "id": 1,
      "description": "A predicate the host cannot decide leaves the guard unproved",
      "pattern": ["Power", "u_", "m_"],
      "constraints": [["PseudoBinomialPairQ", "u", "m"]],
      "result": "u"
    },
    {
      "id": 2,
      "description": "Negating an undecidable predicate does not establish anything",
      "pattern": ["Power", "u_", "m_"],
      "constraints": [["Not", ["PseudoBinomialPairQ", "u", "m"]]],
      "result": "m"
    },
    {
      "id": 3,
      "description": "A disjunction is established by the branch that holds",
      "pattern": ["Power", "u_", "m_"],
      "constraints": [["Or", ["IntegerQ", "m"], ["PseudoBinomialPairQ", "u", "m"]]],
      "result": ["Multiply", "u", "m"],
      "provenance": {"method": "manual"}
    },
    {
      "id": 4,
      "description": "A conjunction with an undecidable branch is not established",
      "pattern": ["Power", "u_", "m_"],
      "constraints": [["And", ["IntegerQ", "m"], ["PseudoBinomialPairQ", "u", "m"]]],
      "result": "u"
    },
    {
      "id": 5,
      "description": "A decidable guard is unaffected",
      "pattern": ["Power", "u_", "m_"],
      "constraints": [["IntegerQ", "m"]],
      "result": "m"
    }
  ]
}
