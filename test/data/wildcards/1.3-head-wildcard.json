{
  "$schema": "open-symbolic-rules/v0.1",
  "section": "1.3",
  "title": "Head-position wildcard fixture",
  "semantics": {
    "Add": "openmath:arith1#plus",
    "Multiply": "openmath:arith1#times"
  },
  "rules": [
    {
      "id": 1,
      "description": "A wildcard in operator position binds the head it matched",
      "pattern": ["f_", "x"],
      "constraints": [],
      "result": ["Multiply", 2, ["f_", "x"]]
    },
    {
      "id": 2,
      "description": "A structural list needs no per-file OpenMath declaration",
      "pattern": ["Add", "a_", "y"],
      "constraints": [["FreeQ", ["List", "a_"], "y"]],
      "result": "a_"
    }
  ]
}
