{
  "$schema": "open-symbolic-rules/v0.1",
  "section": "1.2",
  "title": "Optional wildcard fixture",
  "semantics": {
    "Add": "openmath:arith1#plus",
    "Multiply": "openmath:arith1#times",
    "Power": "openmath:arith1#power",
    "Gcd": "openmath:arith1#gcd",
    "List": "openmath:list1#list"
  },
  "rules": [
    {
      "id": 1,
      "description": "An optional factor defaults to the multiplicative identity",
      "pattern": [
        "Multiply",
        "a.",
        "x"
      ],
      "constraints": [],
      "result": "a.",
      "provenance": {
        "method": "authored",
        "sources": [
          {
            "name": "OpenSymbolicRules.jl test fixtures",
            "locator": "test/data/wildcards/1.2-optional-forms.json"
          }
        ]
      }
    },
    {
      "id": 2,
      "description": "An optional exponent defaults to one",
      "pattern": [
        "Power",
        "x",
        "m."
      ],
      "constraints": [],
      "result": "m.",
      "provenance": {
        "method": "authored",
        "sources": [
          {
            "name": "OpenSymbolicRules.jl test fixtures",
            "locator": "test/data/wildcards/1.2-optional-forms.json"
          }
        ]
      }
    },
    {
      "id": 3,
      "description": "An optional summand defaults to zero",
      "pattern": [
        "Add",
        "a.",
        "x"
      ],
      "constraints": [],
      "result": "a.",
      "provenance": {
        "method": "authored",
        "sources": [
          {
            "name": "OpenSymbolicRules.jl test fixtures",
            "locator": "test/data/wildcards/1.2-optional-forms.json"
          }
        ]
      }
    },
    {
      "id": 4,
      "description": "The canonical RUBI binomial shape binds every optional operand",
      "pattern": [
        "Power",
        [
          "Add",
          "a.",
          [
            "Multiply",
            "b.",
            "x"
          ]
        ],
        "m."
      ],
      "constraints": [],
      "result": [
        "List",
        "a.",
        "b.",
        "m."
      ],
      "provenance": {
        "method": "authored",
        "sources": [
          {
            "name": "OpenSymbolicRules.jl test fixtures",
            "locator": "test/data/wildcards/1.2-optional-forms.json"
          }
        ]
      }
    },
    {
      "id": 5,
      "description": "An optional operand under an n-ary associative head still defaults",
      "pattern": [
        "Add",
        "a.",
        "x",
        "y"
      ],
      "constraints": [],
      "result": "a.",
      "provenance": {
        "method": "authored",
        "sources": [
          {
            "name": "OpenSymbolicRules.jl test fixtures",
            "locator": "test/data/wildcards/1.2-optional-forms.json"
          }
        ]
      }
    },
    {
      "id": 6,
      "description": "An optional wildcard carries its binding into a constraint",
      "pattern": [
        "Multiply",
        "c.",
        "y"
      ],
      "constraints": [
        [
          "NeQ",
          "c.",
          0
        ]
      ],
      "result": "c.",
      "provenance": {
        "method": "authored",
        "sources": [
          {
            "name": "OpenSymbolicRules.jl test fixtures",
            "locator": "test/data/wildcards/1.2-optional-forms.json"
          }
        ]
      }
    }
  ],
  "identity": "test:wildcards/1.2-optional-forms"
}
