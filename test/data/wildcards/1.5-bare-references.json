{
  "$schema": "open-symbolic-rules/v0.1",
  "section": "1.5",
  "title": "Bare binding reference fixture",
  "semantics": {
    "Add": "openmath:arith1#plus",
    "Multiply": "openmath:arith1#times",
    "Power": "openmath:arith1#power"
  },
  "rules": [
    {
      "id": 1,
      "description": "RUBI spells a binding `m_` in the pattern and `m` in the result",
      "pattern": ["Power", "x_", "m."],
      "constraints": [["NeQ", "m", -1]],
      "result": ["Multiply", ["Power", "x", ["Add", "m", 1]],
                             ["Power", ["Add", "m", 1], -1]],
      "provenance": {"method": "converted"}
    },
    {
      "id": 2,
      "description": "A name the pattern never bound stays a free symbol",
      "pattern": ["Power", "y_", 2],
      "constraints": [],
      "result": ["Multiply", "y", "k"]
    },
    {
      "id": 3,
      "description": "A bound head is referable by its bare name too",
      "pattern": ["f_", "z_"],
      "constraints": [],
      "result": ["f", ["Multiply", 2, "z"]]
    }
  ]
}
