  "rules": [
    {
      "id": 1,
      "description": "Pythagorean Identity: sin^2(x) + cos^2(x) = 1",
      "pattern": ["Add", ["Pow", ["Sin", "~x"], 2], ["Pow", ["Cos", "~x"], 2]],
      "constraints": [],
      "result": 1,
      "comment": "Fundamental trigonometric identity."
    }
  ]
